{
  "buildCommand": "node deployment/inject-config.js && node deployment/build-dist.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome.html",
      "permanent": false
    },
    {
      "source": "/blog/HowToMarketSkincareProdcutsUsingInfluencers",
      "destination": "/blog/HowToMarketSkincareProductsUsingInfluencers",
      "permanent": true
    }
  ],
  "functions": {
    "api/llm/*.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/payment/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
