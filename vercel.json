{
  "buildCommand": "node deployment/inject-config.js && node deployment/build-dist.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.runwae.com"
        }
      ],
      "destination": "https://runwae.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/blog/HowToMarketSkincareProdcutsUsingInfluencers",
      "destination": "/blog/HowToMarketSkincareProductsUsingInfluencers",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/refund",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "/faqs#cost",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/welcome"
    },
    {
      "source": "/js/libs/:file",
      "destination": "/js/:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/llm/*.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/billing/*.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/payment/*.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/public/*.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/notify.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
