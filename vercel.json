{
  "buildCommand": "node deployment/inject-config.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path(vercel\\.json|deployment/.*|firebase\\.json|database\\.rules\\.json|README\\.md|error_log|database-debug\\.log|ui-debug\\.log)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/welcome.html",
      "permanent": false
    }
  ],
  "functions": {
    "api/llm/*.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/payment/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
